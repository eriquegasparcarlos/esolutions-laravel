{
    "name": "esolutions/laravel",
    "description": "Base Laravel utilities for ESolutions ecosystem",
    "type": "library",
    "license": "proprietary",
    "authors": [{ "name": "Carlos Erique Gaspar", "email": "eriquegasparcarlos@gmail.com" }],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": { "Esolutions\\Laravel\\": "src/" },
        "files": ["src/Http/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Esolutions\\Laravel\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Esolutions\\Laravel\\Providers\\EsolutionsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
